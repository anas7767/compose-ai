COMPOSE_ENV=local
COMPOSE_API_HOST=0.0.0.0
COMPOSE_API_PORT=8000
DATABASE_URL=postgresql+asyncpg://compose_ai:compose_ai_local_password@localhost:5432/compose_ai
DATABASE_ECHO=false
CORS_ORIGINS=http://localhost:3000

# AI Architect. Use Gemini for real local provider verification.
AI_PROVIDER=gemini
AI_FALLBACK_PROVIDER=
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
EXTERIOR_DESIGN_IMAGE_MODEL=
ASSET_STORAGE_PROVIDER=local
ASSET_STORAGE_LOCAL_ROOT=.compose-assets
ASSET_PUBLIC_BASE_URL=/api/v1/assets
ASSET_STORAGE_PREFIX=compose-ai
ASSET_STORAGE_S3_BUCKET=
ASSET_STORAGE_S3_REGION=us-east-1
ASSET_STORAGE_S3_ENDPOINT_URL=
ASSET_STORAGE_S3_ACCESS_KEY_ID=
ASSET_STORAGE_S3_SECRET_ACCESS_KEY=
ASSET_STORAGE_S3_PUBLIC_BASE_URL=
ASSET_MAX_IMAGE_BYTES=10485760
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_PROJECT=
OPENAI_MODEL_BRIEF=
OPENAI_MODEL_CHAT=
OPENAI_MODEL_NORMALIZER=
OPENAI_MODEL_FLOOR_PLAN=
OPENAI_MODEL_FALLBACK=
AI_PROMPT_ENV=development
AI_REQUEST_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2
AI_MAX_INPUT_TOKENS=32000
AI_MAX_OUTPUT_TOKENS=4000
AI_MAX_CONCURRENT_RUNS_PER_ORG=4
AI_USER_RATE_LIMIT_PER_MINUTE=10
AI_ORG_DAILY_COST_LIMIT_USD=5.00
AI_ORG_MONTHLY_COST_LIMIT_USD=50.00
# Set these from the selected provider model's current published prices.
AI_INPUT_PRICE_PER_1M_USD=0
AI_OUTPUT_PRICE_PER_1M_USD=0
AI_CACHE_TTL_SECONDS=86400
AI_PROVIDER_FAILURE_THRESHOLD=3
AI_PROVIDER_DEGRADED_SECONDS=120
AI_RUN_RETENTION_DAYS=90
AI_MOCK_SEED=compose-ai

# Conceptual floor-plan generation failure budgets and concurrency.
FLOOR_PLAN_MAX_CONCURRENT_RUNS_PER_ORG=2
FLOOR_PLAN_MAX_SOLVER_ATTEMPTS=20
FLOOR_PLAN_MAX_PROVIDER_RETRIES=2
FLOOR_PLAN_MAX_PROCESSING_SECONDS=180
FLOOR_PLAN_MAX_INVALID_CANDIDATES=12
FLOOR_PLAN_DIVERSITY_THRESHOLD=0.250
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
WORKER_HEARTBEAT_STALE_SECONDS=45
READINESS_AI_PROVIDER_CHECK_ENABLED=true
READINESS_AI_PROVIDER_TIMEOUT_SECONDS=5
REDIS_URL=redis://localhost:6379/0
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
